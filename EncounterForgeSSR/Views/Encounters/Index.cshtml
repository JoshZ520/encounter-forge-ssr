@model IEnumerable<EncounterForgeSSR.Models.Encounter>

@{
    ViewData["Title"] = "Encounters";
}

<section class="page-section">
    <div class="page-header">
        <div>
            <p class="section-eyebrow mb-0">Encounter Roster</p>
            <h1 class="page-title">Prep encounters you can scan at a glance.</h1>
            <p class="page-intro">Each entry keeps party context, environment, and monster composition together so you
                can review the whole fight before initiative starts.</p>
            </div>
            <a class="app-btn app-btn--accent" asp-action="Create">Create Encounter</a>
        </div>

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="status-stack">
                <div class="status-banner status-banner--warning">@errorMessage</div>
            </div>
        }

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="status-stack">
                <div class="status-banner status-banner--success">@successMessage</div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="empty-state">
                <h2 class="empty-state__title">No encounters prepared yet.</h2>
                <p class="empty-state__text">Start with one battle plan for your next session, then refine its monsters, notes,
                    and difficulty as the story sharpens.</p>
                    <a class="app-btn app-btn--accent mt-2" asp-action="Create">Build Your First Encounter</a>
                </div>
            }
    else
            {
                <div class="encounter-grid">
                    @foreach (var encounter in Model)
                    {
                        <article class="encounter-card">
                            <div class="encounter-card__top">
                                <div>
                                    <p class="section-eyebrow mb-1">Encounter</p>
                                    <h2 class="encounter-card__title">
                                        <a asp-action="Details" asp-route-id="@encounter.Id">@encounter.Name</a>
                                    </h2>
                                </div>
                                <div class="meta-row">
                                    <span class="meta-chip">Level @encounter.PartyLevel</span>
                                    <span class="meta-chip">Party of @encounter.PartySize</span>
                                    <span class="meta-chip">@encounter.Difficulty</span>
                                </div>
                            </div>

                            <div class="encounter-card__summary">
                                <p class="encounter-card__meta mb-2">Environment: @encounter.Environment</p>
                                @if (!string.IsNullOrWhiteSpace(encounter.Notes))
                                {
                                    <p class="support-copy mb-0">@encounter.Notes</p>
                                }
                            </div>

                            <div class="detail-actions mt-3">
                                <div class="support-copy">Open the dossier, revise details, or retire this encounter from the roster.
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="app-btn app-btn--ghost app-btn--sm" asp-action="Details"
                                       asp-route-id="@encounter.Id">View</a>
                                    <a class="app-btn app-btn--ghost app-btn--sm" asp-action="Edit"
                                       asp-route-id="@encounter.Id">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@encounter.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="app-btn app-btn--danger app-btn--sm"
                                                onclick="return confirm('Delete this encounter?');">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>