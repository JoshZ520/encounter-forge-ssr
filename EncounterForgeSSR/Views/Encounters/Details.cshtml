@model EncounterForgeSSR.Models.Encounter

@{
    ViewData["Title"] = "Encounter Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <div class="btn-group">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Party Level</dt>
    <dd class="col-sm-9">@Model.PartyLevel</dd>

    <dt class="col-sm-3">Party Size</dt>
    <dd class="col-sm-9">@Model.PartySize</dd>

    <dt class="col-sm-3">Environment</dt>
    <dd class="col-sm-9">@Model.Environment</dd>

    <dt class="col-sm-3">Difficulty</dt>
    <dd class="col-sm-9">@Model.Difficulty</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@Model.Notes</dd>
</dl>

<h2 class="h5 mt-4">Monsters</h2>

@if (Model.MonsterEntries.Count == 0)
{
    <p class="text-muted">No monsters attached.</p>
}
else
{
    <ul class="list-group">
        @foreach (var monster in Model.MonsterEntries.OrderBy(monster => monster.SortOrder))
        {
            <li class="list-group-item">
                <strong>@monster.Quantity x @monster.Name</strong> - CR @monster.ChallengeRating
                @if (!string.IsNullOrWhiteSpace(monster.Notes))
                {
                    <div class="text-muted">@monster.Notes</div>
                }
            </li>
        }
    </ul>
}