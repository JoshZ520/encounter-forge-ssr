@model EncounterForgeSSR.Models.Encounter

@{
    ViewData["Title"] = "Encounter Details";
}

<section class="detail-shell">
    <div class="page-header mb-4">
        <div>
            <p class="section-eyebrow mb-0">Encounter Dossier</p>
            <h1 class="page-title">@Model.Name</h1>
            <p class="detail-subtitle mb-0">Review encounter pressure, table context, and monster notes before the scene
                begins.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="app-btn app-btn--ghost" asp-action="Edit" asp-route-id="@Model.Id">Edit Encounter</a>
                <a class="app-btn app-btn--ghost" asp-action="Index">Back to Roster</a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="status-stack">
                <div class="status-banner status-banner--success">@successMessage</div>
            </div>
        }

        <div class="stat-strip">
            <span class="stat-chip">Level @Model.PartyLevel</span>
            <span class="stat-chip">Party of @Model.PartySize</span>
            <span class="stat-chip">@Model.Environment</span>
            <span class="stat-chip">@Model.Difficulty</span>
        </div>

        <div class="detail-grid">
            <dl class="detail-card">
                <dt>Party Level</dt>
                <dd>@Model.PartyLevel</dd>
            </dl>
            <dl class="detail-card">
                <dt>Party Size</dt>
                <dd>@Model.PartySize</dd>
            </dl>
            <dl class="detail-card">
                <dt>Environment</dt>
                <dd>@Model.Environment</dd>
            </dl>
            <dl class="detail-card">
                <dt>Difficulty</dt>
                <dd>@Model.Difficulty</dd>
            </dl>
            <dl class="detail-card" style="grid-column: 1 / -1;">
                <dt>DM Notes</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes added yet." : Model.Notes)</dd>
            </dl>
        </div>

        <div class="monster-blocks">
            <div class="monster-line mb-3">
                <div>
                    <p class="section-eyebrow mb-1">Monster Lineup</p>
                    <h2 class="h4 mb-0">Combat roster</h2>
                </div>
                <div class="support-copy">Keep notes here for position, tactics, and role in the fight.</div>
            </div>

            @if (Model.MonsterEntries.Count == 0)
            {
                <div class="detail-card">No monsters attached.</div>
            }
            else
            {
                <div class="monster-roster">
                    @foreach (var monster in Model.MonsterEntries.OrderBy(monster => monster.SortOrder))
                    {
                        <article class="monster-entry">
                            <div class="monster-line">
                                <div>
                                    <h3 class="h5 mb-1">@monster.Quantity x @monster.Name</h3>
                                    <div class="monster-note">Challenge Rating @monster.ChallengeRating</div>
                                </div>
                                <span class="meta-chip">Order @monster.SortOrder</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(monster.Notes))
                            {
                                <p class="monster-note mb-0 mt-3">@monster.Notes</p>
                            }
                        </article>
                    }
                </div>
            }
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <button type="submit" class="app-btn app-btn--danger" onclick="return confirm('Delete this encounter?');">Delete
                Encounter</button>
            </form>
        </section>