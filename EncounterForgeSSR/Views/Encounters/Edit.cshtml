@model EncounterFormViewModel

@{
    ViewData["Title"] = "Edit Encounter";
}

<h1 class="h3 mb-3">Edit Encounter</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-6 mb-3">
            <label asp-for="PartyLevel" class="form-label"></label>
            <input asp-for="PartyLevel" class="form-control" />
            <span asp-validation-for="PartyLevel" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="PartySize" class="form-label"></label>
            <input asp-for="PartySize" class="form-control" />
            <span asp-validation-for="PartySize" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Environment" class="form-label"></label>
        <input asp-for="Environment" class="form-control" />
        <span asp-validation-for="Environment" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Difficulty" class="form-label"></label>
        <select asp-for="Difficulty" class="form-select">
            <option value="">Select difficulty</option>
            <option>Easy</option>
            <option>Medium</option>
            <option>Hard</option>
            <option>Deadly</option>
        </select>
        <span asp-validation-for="Difficulty" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    @for (var i = 0; i < Model.MonsterEntries.Count; i++)
    {
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 h6">Monster @(i + 1)</legend>
            <input type="hidden" asp-for="MonsterEntries[i].Id" />
            <input type="hidden" asp-for="MonsterEntries[i].EncounterId" />
            <input type="hidden" asp-for="MonsterEntries[i].SortOrder" />

            <div class="mb-3">
                <label asp-for="MonsterEntries[i].Name" class="form-label">Monster Name</label>
                <input asp-for="MonsterEntries[i].Name" class="form-control" />
                <span asp-validation-for="MonsterEntries[i].Name" class="text-danger"></span>
            </div>
            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label asp-for="MonsterEntries[i].Quantity" class="form-label"></label>
                    <input asp-for="MonsterEntries[i].Quantity" class="form-control" />
                    <span asp-validation-for="MonsterEntries[i].Quantity" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MonsterEntries[i].ChallengeRating" class="form-label"></label>
                    <input asp-for="MonsterEntries[i].ChallengeRating" class="form-control" />
                    <span asp-validation-for="MonsterEntries[i].ChallengeRating" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="MonsterEntries[i].Notes" class="form-label"></label>
                <textarea asp-for="MonsterEntries[i].Notes" class="form-control" rows="2"></textarea>
                <span asp-validation-for="MonsterEntries[i].Notes" class="text-danger"></span>
            </div>
        </fieldset>
    }

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}