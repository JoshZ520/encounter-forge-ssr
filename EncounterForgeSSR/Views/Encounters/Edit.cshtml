@model EncounterFormViewModel

@{
    ViewData["Title"] = "Edit Encounter";
}

<section class="form-shell">
    <div class="page-header">
        <div>
            <p class="section-eyebrow mb-0">Revise Encounter</p>
            <h1 class="page-title">Tune the plan before your players hit the scene.</h1>
            <p class="page-intro">Refine pacing, monster pressure, and tactical notes without losing the original
                structure you already built.</p>
            </div>
        </div>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <section class="form-section">
                <div class="form-section__header">
                    <h2 class="form-section__title">Encounter Basics</h2>
                    <p class="form-hint mb-0">Adjust the framing of the fight if the party changed, the terrain evolved, or
                        the scene needs a stronger hook.</p>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Environment" class="form-label"></label>
                        <input asp-for="Environment" class="form-control" />
                        <span asp-validation-for="Environment" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Difficulty" class="form-label"></label>
                        <select asp-for="Difficulty" class="form-select">
                            <option value="">Select difficulty</option>
                            <option>Easy</option>
                            <option>Medium</option>
                            <option>Hard</option>
                            <option>Deadly</option>
                        </select>
                        <span asp-validation-for="Difficulty" class="text-danger"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </section>

                <section class="form-section">
                    <div class="form-section__header">
                        <h2 class="form-section__title">Party Snapshot</h2>
                        <p class="form-hint mb-0">Keep the party numbers accurate so the roster remains useful when you compare
                            encounters.</p>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PartyLevel" class="form-label"></label>
                                <input asp-for="PartyLevel" class="form-control" />
                                <span asp-validation-for="PartyLevel" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PartySize" class="form-label"></label>
                                <input asp-for="PartySize" class="form-control" />
                                <span asp-validation-for="PartySize" class="text-danger"></span>
                            </div>
                        </div>
                    </section>

                    <section class="form-section">
                        <div class="form-section__header">
                            <h2 class="form-section__title">Monster Lineup</h2>
                            <p class="form-hint mb-0">Each block is one part of the battle rhythm. Adjust counts, CR, or notes to
                                fine-tune the encounter.</p>
                            </div>

                            @for (var i = 0; i < Model.MonsterEntries.Count; i++)
                            {
                                <fieldset class="form-section mb-3">
                                    <legend class="float-none w-auto px-0 h6 mb-3">Monster @(i + 1)</legend>
                                    <input type="hidden" asp-for="MonsterEntries[i].Id" />
                                    <input type="hidden" asp-for="MonsterEntries[i].EncounterId" />
                                    <input type="hidden" asp-for="MonsterEntries[i].SortOrder" />

                                    <div class="mb-3">
                                        <label asp-for="MonsterEntries[i].MonsterCatalogId" class="form-label">Monster Catalog</label>
                                        <select asp-for="MonsterEntries[i].MonsterCatalogId" class="form-select"
                                                asp-items="ViewBag.MonsterCatalog">
                                            <option value="">Custom monster...</option>
                                        </select>
                                        <p class="form-hint mb-0">Choose from catalog to auto-fill name and CR on save.</p>
                                    </div>

                                    <div class="mb-3 custom-only custom-name-field">
                                        <label asp-for="MonsterEntries[i].Name" class="form-label">Monster Name</label>
                                        <input asp-for="MonsterEntries[i].Name" class="form-control" />
                                        <span asp-validation-for="MonsterEntries[i].Name" class="text-danger"></span>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6 mb-3">
                                            <label asp-for="MonsterEntries[i].Quantity" class="form-label"></label>
                                            <input asp-for="MonsterEntries[i].Quantity" class="form-control" />
                                            <span asp-validation-for="MonsterEntries[i].Quantity" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6 mb-3 custom-only custom-cr-field">
                                            <label asp-for="MonsterEntries[i].ChallengeRating" class="form-label"></label>
                                            <input asp-for="MonsterEntries[i].ChallengeRating" class="form-control" />
                                            <span asp-validation-for="MonsterEntries[i].ChallengeRating" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="mb-0">
                                        <label asp-for="MonsterEntries[i].Notes" class="form-label"></label>
                                        <textarea asp-for="MonsterEntries[i].Notes" class="form-control" rows="2"></textarea>
                                        <span asp-validation-for="MonsterEntries[i].Notes" class="text-danger"></span>
                                    </div>
                                </fieldset>
                            }
                        </section>

                        <div class="form-actions mt-4">
                            <p class="support-copy mb-0">Save when the encounter reflects the pacing and pressure you want at the table.
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="app-btn app-btn--accent">Save Changes</button>
                                <a class="app-btn app-btn--ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                            </div>
                        </div>
                    </form>
                </section>

                @section Scripts {
                    <partial name="_ValidationScriptsPartial" />
                    <script>
                        (() => {
                            const wireMonsterRow = (catalogSelect) => {
                                const fieldset = catalogSelect.closest('fieldset');
                                if (!fieldset) {
                                    return;
                                }

                                const customFields = fieldset.querySelectorAll('.custom-only');

                                const syncVisibility = () => {
                                    const isCustom = !catalogSelect.value;
                                    customFields.forEach(field => {
                                        field.style.display = isCustom ? '' : 'none';
                                    });
                                };

                                catalogSelect.addEventListener('change', syncVisibility);
                                syncVisibility();
                            };

                            document.querySelectorAll('select[name$=".MonsterCatalogId"]').forEach(wireMonsterRow);
                        })();
                    </script>
                }