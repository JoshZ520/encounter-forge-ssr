@model LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="page-shell">
    <section class="form-shell">
        <div class="page-header">
            <div>
                <p class="section-eyebrow mb-0">Account Access</p>
                <h1 class="page-title">Sign in to manage encounters.</h1>
                <p class="page-intro">Use your account to access your planning dashboard and edit encounter drafts.</p>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="status-stack mb-3">
                <div class="status-banner status-banner--success">@successMessage</div>
            </div>
        }

        <form asp-action="Login" method="post" class="forge-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <section class="form-section">
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="mb-0">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </section>

            <div class="form-actions">
                <button type="submit" class="app-btn app-btn--accent">Sign In</button>
                <a class="app-btn app-btn--ghost" asp-action="Register">Create Account</a>
            </div>

            <p class="support-copy mb-0">Default seeded account: <strong>dmadmin</strong> / <strong>Encounter123!</strong></p>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
