<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Encounter Forge</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EncounterForgeSSR.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">
        <header class="site-header">
            <div class="page-frame">
                <nav class="navbar navbar-expand-md site-nav">
                    <a class="brand-mark" asp-area="" asp-controller="Encounters" asp-action="Index">
                        <span class="brand-mark__eyebrow">Encounter Forge</span>
                        <span class="brand-mark__title">Session-ready battle plans</span>
                    </a>
                    <button class="navbar-toggler site-nav__toggle" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav ms-auto align-items-md-center gap-md-2">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <li class="nav-item">
                                    <a class="nav-link site-nav__link" asp-area="" asp-controller="Encounters"
                                       asp-action="Index">Encounter Roster</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn app-btn app-btn--accent app-btn--sm" asp-area=""
                                       asp-controller="Encounters" asp-action="Create">New Encounter</a>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link site-nav__link">@User.Identity!.Name</span>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn app-btn app-btn--ghost app-btn--sm">Log Out</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="btn app-btn app-btn--ghost app-btn--sm" asp-controller="Account" asp-action="Login">Sign In</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn app-btn app-btn--accent app-btn--sm" asp-controller="Account" asp-action="Register">Register</a>
                                </li>
                            }
                        </ul>
                    </div>
                </nav>
                <div class="site-hero">
                    <p class="site-hero__eyebrow">Dungeon Master Toolkit</p>
                    <h1 class="site-hero__title">Build encounters that read clearly at the table.</h1>
                    <p class="site-hero__text">Track party context, monster lineups, and tactical notes in a layout
                        designed for session prep instead of generic forms.</p>
                </div>
            </div>
        </header>

        <main role="main" class="page-frame page-content">
            @RenderBody()
        </main>

        <footer class="site-footer page-frame">
            <div>
                <div class="site-footer__title">Encounter Forge</div>
                <div class="site-footer__text">A compact SSR planning workspace for memorable combat sessions.</div>
            </div>
            <div class="site-footer__text">&copy; 2026</div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
